<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_plazy" model="ir.module.category">
        <field name="name">Plazy</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_account_type" model="res.groups.privilege">
        <field name="name">Plazy Account Type</field>
        <field name="category_id" ref="plazy.module_category_plazy"/>
        <field name="placeholder">No Plazy account</field>
        <field name="sequence">10</field>
    </record>

    <record id="player" model="res.groups">
        <field name="name">Player</field>
        <field name="privilege_id" ref="plazy.privilege_account_type"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="team" model="res.groups">
        <field name="name">Team</field>
        <field name="privilege_id" ref="plazy.privilege_account_type"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
