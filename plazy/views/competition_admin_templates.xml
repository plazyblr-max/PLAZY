<odoo>
    <template id="competition_admin_workbench" inherit_id="plazy.competition_dashboard"><xpath expr="//div[hasclass('pz-admin-links')]" position="after"><section t-if="admin"><div class="pz-invite-row"><h2>Competition workspace</h2><a class="plazy-primary-action" href="/plazy/admin/tournament/new">Create tournament <i class="fa fa-plus"/></a></div><a t-foreach="admin_tournaments" t-as="entry" class="pz-invite-row" t-att-href="'/plazy/admin/tournament/%s' % entry.id"><strong t-out="entry.name"/><span class="pz-competition-badge" t-out="dict(entry._fields['state'].selection)[entry.state]"/><i class="fa fa-arrow-right"/></a></section></xpath></template>
    <template id="competition_manage"><t t-call="plazy.competition_layout"><section class="pz-competition"><a class="pz-back" href="/plazy/competition/dashboard"><i class="fa fa-arrow-left"/> Competition workspace</a><header class="pz-competition-heading"><p class="plazy-eyebrow">ADMINISTRATION</p><h1 t-out="tournament.name if tournament else 'Create a competition.'"/></header><p t-if="error" role="alert" class="pz-notice" t-out="error"/><p t-if="request.session.get('plazy_competition_message')" role="status" class="pz-notice" t-out="request.session.pop('plazy_competition_message')"/>
    <form t-if="not tournament" class="pz-admin-form" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Name<input name="name" required="required" t-att-value="form.get('name')"/></label><label>Location<input name="location" required="required" t-att-value="form.get('location')"/></label><label>Football format<select name="football_format"><option value="seven_a_side">7-a-side</option><option value="five_a_side">5-a-side</option></select></label><label>Competition format<select name="format"><option value="hybrid">League + Knockout</option><option value="league">League</option><option value="knockout">Knockout</option></select></label><label t-foreach="[('registration_start', 'Registration opens'), ('registration_end', 'Registration closes'), ('start_date', 'Competition starts'), ('end_date', 'Competition ends')]" t-as="item"><t t-out="item[1]"/> (<t t-out="timezone"/>)<input type="datetime-local" t-att-name="item[0]" t-att-value="form.get(item[0])" required="required"/></label><label t-foreach="[('min_teams', 'Minimum teams', 4), ('max_teams', 'Maximum teams', 16), ('group_count', 'League groups', 4), ('qualifiers', 'Qualifiers per group', 2), ('duration', 'Match minutes', 40)]" t-as="item"><t t-out="item[1]"/><input type="number" min="1" t-att-name="item[0]" t-att-value="form.get(item[0], item[2])" required="required"/></label><label class="pz-wide">Description<textarea name="description" rows="3" t-out="form.get('description')"/></label><label class="pz-wide">Rules<textarea name="rules" rows="5" t-out="form.get('rules')"/></label><button class="plazy-primary-action" type="submit">Create draft <i class="fa fa-plus"/></button></form>
    <t t-if="tournament"><div class="pz-admin-actions"><span class="pz-competition-badge" t-out="dict(tournament._fields['state'].selection)[tournament.state]"/><a t-att-href="'/odoo/action-plazy.action_tournaments/%s' % tournament.id">Edit configuration and grounds <i class="fa fa-pencil"/></a><a t-if="tournament.published" t-att-href="'/plazy/tournaments/%s' % tournament.id">Public page <i class="fa fa-external-link"/></a></div><div class="pz-admin-actions"><form t-foreach="[('open', 'Open registration'), ('close', 'Close registration'), ('league', 'Generate league'), ('knockout', 'Generate knockout'), ('schedule', 'Auto schedule'), ('publish', 'Publish fixtures'), ('complete', 'Complete tournament')]" t-as="action" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" name="action" t-att-value="action[0]" class="plazy-primary-action" t-out="action[1]"/></form></div><h2>Team applications</h2><p t-if="not tournament.registration_ids" class="pz-empty">No applications yet.</p><div t-foreach="tournament.registration_ids" t-as="entry" class="pz-invite-row"><div><strong t-out="entry.team_id.name"/><p t-out="entry.state.title()"/></div><t t-if="entry.state in ('pending', 'waitlisted')"><form method="post" t-att-action="'/plazy/admin/application/%s/approve' % entry.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="plazy-primary-action">Approve</button></form><form method="post" t-att-action="'/plazy/admin/application/%s/reject' % entry.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input name="reason" required="required" aria-label="Rejection reason" placeholder="Rejection reason"/><button type="submit" class="plazy-primary-action">Reject</button></form></t></div><h2>Fixtures and official results</h2><p t-if="not tournament.match_ids" class="pz-empty">Close registration and generate fixtures to begin.</p><div class="pz-table-scroll"><table class="pz-table"><thead><tr><th>Round</th><th>Home</th><th>Away</th><th>Kickoff</th><th>Status</th><th>Result</th></tr></thead><tbody><tr t-foreach="tournament.match_ids" t-as="m"><td t-out="m.round_number"/><th t-out="m.home_id.name or 'To be decided'"/><td t-out="m.away_id.name or 'To be decided'"/><td><span t-field="m.kickoff"/></td><td t-out="m.state.title()"/><td><a t-att-href="'/plazy/admin/match/%s/result' % m.id"><i class="fa fa-pencil"/> Manage result</a></td></tr></tbody></table></div></t></section></t></template>
    <template id="competition_result_editor"><t t-call="plazy.competition_layout"><section class="pz-competition"><a class="pz-back" t-att-href="'/plazy/admin/tournament/%s' % match.tournament_id.id"><i class="fa fa-arrow-left"/> <t t-out="match.tournament_id.name"/></a><header class="pz-competition-heading"><p class="plazy-eyebrow">OFFICIAL RESULT</p><h1><t t-out="match.home_id.name or 'To be decided'"/> vs <t t-out="match.away_id.name or 'To be decided'"/></h1></header><p t-if="error" class="pz-notice" role="alert" t-out="error"/><form method="post" class="pz-admin-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><t t-if="match.state not in ('completed', 'walkover')"><label t-foreach="[('home_score', 'Home goals'), ('away_score', 'Away goals'), ('extra_home', 'Home extra-time goals'), ('extra_away', 'Away extra-time goals'), ('penalties_home', 'Home penalties'), ('penalties_away', 'Away penalties')]" t-as="item"><t t-out="item[1]"/><input type="number" min="0" required="required" t-att-name="item[0]" t-att-value="match[item[0]]"/></label><label class="pz-wide">Match notes<textarea name="notes" t-out="match.notes"/></label><button type="submit" class="plazy-primary-action">Confirm official result <i class="fa fa-check"/></button></t><t t-else=""><p>Official score: <t t-out="match.home_score + match.extra_home"/> - <t t-out="match.away_score + match.extra_away"/></p><label class="pz-wide">Correction reason<textarea name="reason" required="required"/></label><button type="submit" class="plazy-primary-action" name="action" value="reopen">Reopen for correction</button></t></form><h2>Result history</h2><div t-foreach="match.audit_ids" t-as="entry" class="pz-invite-row"><time t-field="entry.create_date"/><strong t-out="entry.create_uid.name"/><p t-out="entry.description"/></div></section></t></template>
</odoo>
