<odoo>
    <template id="competition_pagination"><nav class="pz-pagination" aria-label="Pagination"><a t-if="previous_url" t-att-href="previous_url" aria-label="Previous page"><i class="fa fa-arrow-left"/> Previous</a><span>Page <t t-out="page"/> of <t t-out="page_count"/></span><a t-if="next_url" t-att-href="next_url" aria-label="Next page">Next <i class="fa fa-arrow-right"/></a></nav></template>
    <template id="competition_listing_filters" inherit_id="plazy.competition_listing"><xpath expr="//div[hasclass('pz-tournament-grid')]" position="before"><form method="get" action="/plazy/tournaments" class="pz-filters"><label>Competition<input type="search" name="q" t-att-value="query" placeholder="Search tournaments"/></label><label>Football<select name="format"><option value="">All formats</option><option value="five_a_side" t-att-selected="football_format == 'five_a_side'">5-a-side</option><option value="seven_a_side" t-att-selected="football_format == 'seven_a_side'">7-a-side</option></select></label><label>Status<select name="state"><option value="">All competitions</option><option t-foreach="[('open', 'Registration open'), ('scheduled', 'Scheduled'), ('live', 'In progress'), ('completed', 'Completed')]" t-as="choice" t-att-value="choice[0]" t-att-selected="filter_state == choice[0]" t-out="choice[1]"/></select></label><button class="plazy-primary-action" type="submit"><i class="fa fa-search"/> Search</button></form></xpath><xpath expr="//div[hasclass('pz-tournament-grid')]" position="after"><t t-call="plazy.competition_pagination"/></xpath></template>
    <template id="competition_history_pagination" inherit_id="plazy.competition_dashboard"><xpath expr="//t[@t-call='plazy.competition_match_rows']" position="after"><t t-call="plazy.competition_pagination"/></xpath></template>
    <template id="player_discovery_consent" inherit_id="plazy.player_dashboard"><xpath expr="//section[hasclass('plazy-profile-card')]" position="after"><section class="plazy-profile-card"><h2>Player discovery</h2><form method="post" action="/plazy/player/discovery"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label><input type="checkbox" name="discoverable" value="yes" t-att-checked="player.discoverable"/> Allow team managers to find me by email prefix.</label><p>Your name, email and playing position can appear to team managers while you are available. Your phone number stays private.</p><button type="submit" class="plazy-primary-action">Save preference</button></form></section></xpath></template>
    <template id="result_correction_impact" inherit_id="plazy.competition_result_editor">
        <xpath expr="//button[@value='reopen']" position="after"><section class="pz-wide" t-if="dependents"><h2>Dependent fixtures</h2><ul><li t-foreach="dependents" t-as="dependent"><t t-out="dependent.round_label"/>: <t t-out="dependent.home_id.name or 'To be decided'"/> / <t t-out="dependent.away_id.name or 'To be decided'"/> (<t t-out="dependent.state"/>)</li></ul><button type="submit" class="plazy-primary-action" name="action" value="prepare_correction">Unpublish dependent fixtures and reopen</button></section></xpath>
    </template>
    <template id="competition_admin_user_link" inherit_id="plazy.admin_dashboard"><xpath expr="//a[@href='/odoo/action-base.action_res_users']" position="attributes"><attribute name="t-if">request.env.user.has_group('base.group_system')</attribute></xpath></template>
    <template id="competition_tie_workspace" inherit_id="plazy.competition_manage"><xpath expr="//div[hasclass('pz-admin-actions')][1]" position="inside"><a t-att-href="'/odoo/action-plazy.action_competition_groups'">Groups and tie decisions <i class="fa fa-list-ol"/></a></xpath></template>
</odoo>
