<odoo>
    <template id="competition_layout"><t t-call="plazy.website_layout"><main class="pz-competition-main"><t t-out="0"/></main></t></template>
    <template id="competition_invite_email_first" inherit_id="plazy.invite_player_guided"><xpath expr="//section[@data-step='name']" position="before"><xpath expr="//section[@data-step='email']" position="move"/></xpath></template>
    <template id="competition_nav" inherit_id="plazy.portal_header"><xpath expr="//nav" position="inside"><a href="/plazy/tournaments">Tournaments</a></xpath></template>
    <template id="competition_team_link" inherit_id="plazy.team_dashboard"><xpath expr="//div[hasclass('plazy-portal-intro')]" position="after"><a class="plazy-primary-action" href="/plazy/competition/dashboard">Competitions, fixtures and results <i class="fa fa-arrow-right"/></a></xpath></template>
    <template id="competition_player_link" inherit_id="plazy.player_dashboard"><xpath expr="//div[hasclass('plazy-portal-intro')]" position="after"><a class="plazy-primary-action" href="/plazy/competition/dashboard">Invitations and match centre <i class="fa fa-arrow-right"/></a></xpath></template>
    <template id="competition_admin_link" inherit_id="plazy.admin_dashboard"><xpath expr="//div[hasclass('plazy-admin-grid')]" position="inside"><a class="plazy-admin-card" href="/plazy/competition/dashboard"><span>Competition management</span><strong><i class="fa fa-trophy"/></strong><small>Tournaments, applications and official results</small></a></xpath></template>

    <template id="competition_listing" name="PLAZY Tournaments"><t t-call="plazy.competition_layout"><section class="pz-competition"><header class="pz-competition-heading"><p class="plazy-eyebrow">PLAZY FOOTBALL</p><h1>Find your next competition.</h1><p>Different teams. One game.</p></header><div class="pz-tournament-grid"><a t-foreach="tournaments" t-as="t" t-att-href="'/plazy/tournaments/%s' % t.id" class="pz-tournament"><span class="pz-competition-badge" t-out="dict(t._fields['state'].selection)[t.state]"/><img t-if="t.logo" t-att-src="image_data_uri(t.logo)" width="72" height="72" alt="Tournament logo"/><i t-else="" class="fa fa-trophy pz-trophy" aria-hidden="true"/><h2 t-out="t.name"/><p t-out="t.location"/><p><span t-out="dict(t._fields['football_format'].selection)[t.football_format]"/> · <span t-out="dict(t._fields['format'].selection)[t.format]"/></p><time t-field="t.start_date"/><div class="pz-tournament-bottom"><span><t t-out="t.approved_count"/> / <t t-out="t.max_teams"/> teams</span><i class="fa fa-arrow-right"/></div></a></div><p t-if="not tournaments" class="pz-empty">No competitions have been announced yet.</p></section></t></template>

    <template id="competition_match_rows"><div class="pz-fixtures"><a t-foreach="matches" t-as="m" t-att-href="'/plazy/matches/%s' % m.id" class="pz-fixture"><div><small t-out="m.round_label"/><time t-if="m.kickoff" t-field="m.kickoff"/><span t-else="" t-out="'Automatic advance' if m.is_bye else 'Schedule pending'"/></div><strong t-out="m.home_id.name or 'To be decided'"/><span class="pz-score"><t t-if="m.state in ('completed', 'walkover', 'live')"><t t-out="m.home_score + m.extra_home"/> : <t t-out="m.away_score + m.extra_away"/></t><t t-elif="m.is_bye">BYE</t><t t-else="">vs</t></span><strong t-out="m.away_id.name or ('No opponent' if m.is_bye else 'To be decided')"/><span class="pz-competition-badge" t-out="m.state.title()"/></a></div><p t-if="not matches" class="pz-empty">No matches to show yet.</p></template>

    <template id="competition_detail" name="Tournament"><t t-call="plazy.competition_layout"><section class="pz-competition"><a href="/plazy/tournaments" class="pz-back"><i class="fa fa-arrow-left"/> All tournaments</a><header class="pz-competition-heading"><p class="plazy-eyebrow" t-out="tournament.location"/><h1 t-out="tournament.name"/><p><span t-out="dict(tournament._fields['state'].selection)[tournament.state]"/> · <span t-field="tournament.start_date"/></p><p t-if="tournament.champion_id"><i class="fa fa-trophy"/> Champions: <strong t-out="tournament.champion_id.name"/></p></header><p t-if="message" role="status" class="pz-notice" t-out="message"/>
    <nav class="pz-tabs" aria-label="Tournament views"><a t-foreach="['overview', 'teams', 'fixtures', 'results', 'standings', 'bracket', 'rules']" t-as="item" t-att-href="'/plazy/tournaments/%s?tab=%s' % (tournament.id, item)" t-att-aria-current="'page' if tab == item else None" t-out="item.title()"/></nav>
    <div t-if="tab == 'overview'" class="pz-overview"><div><h2>Competition details</h2><p class="pz-prose" t-out="tournament.description"/><dl class="pz-facts"><div><dt>Football</dt><dd t-out="dict(tournament._fields['football_format'].selection)[tournament.football_format]"/></div><div><dt>Format</dt><dd t-out="dict(tournament._fields['format'].selection)[tournament.format]"/></div><div><dt>Registration closes</dt><dd><span t-field="tournament.registration_end"/></dd></div><div><dt>Teams</dt><dd><t t-out="tournament.approved_count"/> / <t t-out="tournament.max_teams"/></dd></div><div><dt>Match duration</dt><dd><t t-out="tournament.duration"/> minutes</dd></div></dl></div><aside><h2>Your next game starts here.</h2><p t-if="application">Your application: <strong t-out="application.state.title()"/></p><form t-elif="team and tournament.state == 'open'" method="post" t-att-action="'/plazy/tournaments/%s/register' % tournament.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label><input type="checkbox" required="required"/> I have read the tournament rules.</label><button class="plazy-primary-action" type="submit">Register <t t-out="team.name"/> <i class="fa fa-arrow-right"/></button></form><a t-elif="request.env.user._is_public()" class="plazy-primary-action" href="/web/login">Log in to register</a><p t-else="">Registration is available to eligible team managers while applications are open.</p></aside></div>
    <div t-if="tab == 'teams'" class="pz-tournament-grid"><div t-foreach="teams" t-as="entry" class="pz-tournament"><img t-if="entry.logo" t-att-src="image_data_uri(entry.logo)" width="64" height="64" alt="Team logo"/><i t-else="" class="fa fa-shield pz-trophy"/><h2 t-out="entry.name"/></div><p t-if="not teams" class="pz-empty">No teams approved yet.</p></div>
    <t t-if="tab in ('fixtures', 'results')"><t t-set="matches" t-value="matches.filtered(lambda m: (m.state in ('completed', 'walkover')) == (tab == 'results'))"/><t t-call="plazy.competition_match_rows"/></t>
    <div t-if="tab == 'standings'"><section t-foreach="tables" t-as="table"><h2 t-out="table[0].name"/><div class="pz-table-scroll"><table class="pz-table"><thead><tr><th>Team</th><th t-foreach="['P', 'W', 'D', 'L', 'GF', 'GA', 'GD', 'Pts']" t-as="label" t-out="label"/></tr></thead><tbody><tr t-foreach="table[1]" t-as="row"><th t-out="row['team'].name"/><td t-foreach="['p', 'w', 'd', 'l', 'gf', 'ga', 'gd', 'pts']" t-as="key" t-out="row[key]"/></tr></tbody></table></div></section><p t-if="not tables" class="pz-empty">Standings will appear when the league schedule is published.</p></div>
    <div t-if="tab == 'bracket'" class="pz-bracket"><t t-set="knockout" t-value="matches.filtered(lambda m: m.stage == 'knockout')"/><section t-foreach="sorted(set(knockout.mapped('round_number')))" t-as="round_index"><h2 t-out="knockout.filtered(lambda m: m.round_number == round_index)[0].round_label"/><a t-foreach="knockout.filtered(lambda m: m.round_number == round_index)" t-as="m" t-att-href="'/plazy/matches/%s' % m.id" class="pz-bracket-match"><small t-if="m.is_third_place">Third place</small><span t-out="m.home_id.name or 'To be decided'"/><strong><t t-if="m.state == 'completed'"><t t-out="m.home_score + m.extra_home"/> : <t t-out="m.away_score + m.extra_away"/></t><t t-elif="m.is_bye">BYE</t><t t-else="">vs</t></strong><span t-out="m.away_id.name or ('No opponent' if m.is_bye else 'To be decided')"/></a></section><p t-if="not knockout" class="pz-empty">The knockout bracket has not been published yet.</p></div>
    <div t-if="tab == 'rules'" class="pz-prose"><h2>Competition rules</h2><p t-out="tournament.rules or 'Rules will be announced before registration opens.'"/><p>Win: <t t-out="tournament.win_points"/> points · Draw: <t t-out="tournament.draw_points"/> · Loss: <t t-out="tournament.loss_points"/></p><p t-out="dict(tournament._fields['tie_breaker'].selection)[tournament.tie_breaker]"/></div>
    </section></t></template>

    <template id="competition_match" name="Match Centre"><t t-call="plazy.competition_layout"><section class="pz-competition"><a t-att-href="'/plazy/tournaments/%s?tab=fixtures' % match.tournament_id.id" class="pz-back"><i class="fa fa-arrow-left"/> <t t-out="match.tournament_id.name"/></a><header class="pz-competition-heading"><p class="plazy-eyebrow">MATCH CENTRE</p><p><t t-out="match.round_label"/> · <t t-out="match.state.title()"/></p></header><div class="pz-scoreboard"><div><img t-if="match.home_id.logo" t-att-src="image_data_uri(match.home_id.logo)" width="80" height="80" alt="Home team logo"/><h1 t-out="match.home_id.name or 'To be decided'"/></div><strong><t t-if="match.state in ('completed', 'walkover', 'live')"><t t-out="match.home_score + match.extra_home"/> : <t t-out="match.away_score + match.extra_away"/></t><t t-elif="match.is_bye">BYE</t><t t-else="">vs</t></strong><div><img t-if="match.away_id.logo" t-att-src="image_data_uri(match.away_id.logo)" width="80" height="80" alt="Away team logo"/><h1 t-out="match.away_id.name or ('No opponent' if match.is_bye else 'To be decided')"/></div></div><p t-if="match.penalties_home or match.penalties_away">Penalties: <t t-out="match.penalties_home"/> - <t t-out="match.penalties_away"/></p><div class="pz-match-meta"><p><i class="fa fa-calendar"/> <span t-field="match.kickoff"/></p><p><i class="fa fa-map-marker"/> <span t-out="match.venue_id.name or 'Venue pending'"/></p><p><t t-out="match.duration"/> minutes</p></div></section></t></template>

    <template id="competition_dashboard" name="Competition Dashboard"><t t-call="plazy.competition_layout"><section class="pz-competition"><a href="/plazy/dashboard" class="pz-back"><i class="fa fa-arrow-left"/> My dashboard</a><header class="pz-competition-heading"><p class="plazy-eyebrow">YOUR FOOTBALL LIFE</p><h1 t-if="admin">Competition control.</h1><h1 t-else="">Your match centre.</h1><a href="/plazy/tournaments" class="plazy-primary-action">Explore tournaments <i class="fa fa-arrow-right"/></a></header><p t-if="message" class="pz-notice" role="status" t-out="message"/><div t-if="admin" class="pz-admin-links"><a href="/odoo/action-plazy.action_tournaments"><strong t-out="tournament_count"/> Active tournaments <i class="fa fa-trophy"/></a><a href="/odoo/action-plazy.action_competition_registrations"><strong t-out="pending_count"/> Pending applications <i class="fa fa-check-square-o"/></a><a href="/odoo/action-plazy.action_competition_matches">Schedule and results <i class="fa fa-calendar"/></a><a href="/odoo/action-plazy.action_competition_venues">Ground availability <i class="fa fa-map-marker"/></a></div>
    <section t-if="invitations"><h2>You're invited.</h2><div t-foreach="invitations" t-as="invite" class="pz-invite-row"><div><strong t-out="invite.team_id.name"/><p>Invited you to join their squad.</p></div><form t-foreach="['accept', 'reject']" t-as="action" method="post" t-att-action="'/plazy/player/invitations/%s/%s' % (invite.id, action)"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="plazy-primary-action" t-out="action.title()"/></form></div></section>
    <section t-if="registrations"><h2>Your competitions</h2><div t-foreach="registrations" t-as="entry" class="pz-invite-row"><a t-att-href="'/plazy/tournaments/%s' % entry.tournament_id.id" t-out="entry.tournament_id.name"/><span class="pz-competition-badge" t-out="entry.state.title()"/><form t-if="entry.team_id.user_id == request.env.user and entry.state in ('pending', 'approved', 'waitlisted') and not entry.tournament_id.match_ids" method="post" t-att-action="'/plazy/team/registrations/%s/withdraw' % entry.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="plazy-primary-action">Withdraw</button></form></div></section><section><h2>Fixtures and results</h2><t t-call="plazy.competition_match_rows"/></section></section></t></template>
</odoo>
