<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout" inherit_id="web.login_layout" name="Plazy Login Layout" priority="30">
        <xpath expr="t[@t-call]" position="replace">
            <t t-call="plazy.website_layout" head="head"><t t-out="0"/></t>
        </xpath>
    </template>

    <template id="login" inherit_id="web.login" name="Plazy Common Login">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace"><t t-call="web.login_layout" head="head"><main class="plazy-auth-page" aria-labelledby="plazy-login-title"><section class="plazy-auth-panel plazy-login-panel"><h1 id="plazy-login-title">Welcome back</h1><p class="plazy-auth-intro">Play together. Grow together.</p><p class="plazy-site-description">Plazy is a Bengaluru-based football hosting platform that brings players and teams together. Find matches, join teams, meet new players, and enjoy football with your local community.</p><p class="plazy-site-description">Whether you are looking for a team or searching for players, Plazy makes it simple to connect, play, and grow together.</p><form class="plazy-form" action="/web/login" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="login">Email or login</label><input id="login" name="login" type="text" t-att-value="login" required="required" autocomplete="username" autocapitalize="off"/><label for="password">Password</label><input id="password" name="password" type="password" required="required" autocomplete="current-password"/><p class="plazy-form-error" t-if="error" role="alert"><t t-out="error"/></p><p class="plazy-form-success" t-if="message or request.params.get('reset_success')" role="status"><t t-out="message or 'Password changed successfully. You can now log in with your new password.'"/></p><input type="hidden" name="type" value="password"/><input type="hidden" name="redirect" value="/plazy/login/redirect"/><button class="plazy-primary-action" type="submit">Log in</button></form><a class="plazy-text-link plazy-forgot-password-link" href="/plazy/forgot-password">Forgot Password?</a><div class="plazy-login-register"><p>New to Plazy?</p><div class="plazy-role-grid"><a class="plazy-role-option" href="/plazy/player/join"><span class="plazy-role-mark">P</span><span class="plazy-role-copy"><strong>Join as Player</strong><small>Create a player account</small></span></a><a class="plazy-role-option" href="/plazy/team/join"><span class="plazy-role-mark">T</span><span class="plazy-role-copy"><strong>Join as Team</strong><small>Create a team account</small></span></a></div></div></section></main></t></xpath>
    </template>

    <template id="join_choice" name="Plazy Join Choice">
        <t t-call="plazy.website_layout"><main class="plazy-choice-page" aria-labelledby="plazy-choice-title"><section class="plazy-choice-content"><p class="plazy-eyebrow">PLAZY FOOTBALL</p><h1 id="plazy-choice-title">Find your place on the field.</h1><p class="plazy-choice-intro">Choose how you want to join Plazy.</p><div class="plazy-role-grid"><a class="plazy-role-option" href="/plazy/player/join"><span class="plazy-role-mark">P</span><span class="plazy-role-copy"><strong>Join as Player</strong><small>Build your player profile</small></span></a><a class="plazy-role-option" href="/plazy/team/join"><span class="plazy-role-mark">T</span><span class="plazy-role-copy"><strong>Join as Team</strong><small>Set up your team profile</small></span></a></div></section></main></t>
    </template>

    <template id="otp_verify" name="Verify Plazy Registration Email">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="plazy-otp-title"><section class="plazy-auth-panel plazy-otp-panel"><p class="plazy-eyebrow">EMAIL VERIFICATION</p><h1 id="plazy-otp-title">Verify your email</h1><p class="plazy-auth-intro">We sent a six-digit code to <strong><t t-out="email"/></strong>. Enter it below to complete your <t t-out="account_type"/> registration.</p><form class="plazy-form plazy-otp-form" method="post" action="/plazy/verify-email"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="otp_code">Verification code</label><input id="otp_code" class="plazy-otp-input" name="otp_code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required="required"/><p class="plazy-form-error" t-if="error" role="alert"><t t-out="error"/></p><p class="plazy-form-success" t-if="message" role="status"><t t-out="message"/></p><button class="plazy-primary-action" name="action" value="verify" type="submit">Verify code</button><button class="plazy-otp-resend" name="action" value="resend" type="submit">Resend code</button></form></section></main></t>
    </template>

    <template id="forgot_password" name="Plazy Forgot Password">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="plazy-forgot-password-title"><section class="plazy-auth-panel plazy-otp-panel"><p class="plazy-eyebrow">PASSWORD RESET</p><h1 id="plazy-forgot-password-title">Reset your password</h1><p class="plazy-auth-intro">Enter the email address linked to your Plazy account. We will send a verification code.</p><form class="plazy-form plazy-reset-email-form" method="post" action="/plazy/forgot-password"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="reset_email">Registered email address</label><input id="reset_email" name="email" type="email" t-att-value="email" required="required" autocomplete="email"/><p class="plazy-email-message" aria-live="polite"/><p class="plazy-form-error" t-if="error" role="alert"><t t-out="error"/></p><div class="plazy-form-actions"><a class="plazy-secondary-action" href="/web/login">Back</a><button class="plazy-primary-action" type="submit">Send verification code</button></div></form></section></main></t>
    </template>

    <template id="password_reset_otp_verify" name="Verify Plazy Password Reset">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="plazy-reset-otp-title"><section class="plazy-auth-panel plazy-otp-panel"><p class="plazy-eyebrow">PASSWORD RESET</p><h1 id="plazy-reset-otp-title">Verify your email</h1><p class="plazy-auth-intro">We sent a six-digit code to <strong><t t-out="email"/></strong>. Enter it to continue.</p><form class="plazy-form plazy-otp-form" method="post" action="/plazy/forgot-password/verify"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="reset_otp_code">Verification code</label><input id="reset_otp_code" class="plazy-otp-input" name="otp_code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required="required"/><p class="plazy-form-error" t-if="error" role="alert"><t t-out="error"/></p><p class="plazy-form-success" t-if="message" role="status"><t t-out="message"/></p><button class="plazy-primary-action" name="action" value="verify" type="submit">Verify code</button><button class="plazy-otp-resend" name="action" value="resend" type="submit">Resend code</button></form></section></main></t>
    </template>

    <template id="reset_password" name="Set Plazy Password">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="plazy-new-password-title"><section class="plazy-auth-panel plazy-otp-panel"><p class="plazy-eyebrow">PASSWORD RESET</p><h1 id="plazy-new-password-title">Choose a new password</h1><p class="plazy-auth-intro">Use at least eight characters and confirm your new password.</p><form class="plazy-form" data-plazy-password-form="1" method="post" action="/plazy/reset-password"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="reset_token" t-att-value="reset_token"/><label for="new_password">New password</label><input id="new_password" name="password" type="password" required="required" autocomplete="new-password" minlength="8"/><label for="confirm_new_password">Confirm new password</label><input id="confirm_new_password" name="confirm_password" type="password" required="required" autocomplete="new-password" minlength="8"/><p class="plazy-form-error" t-if="error" role="alert"><t t-out="error"/></p><p class="plazy-form-success" t-if="message" role="status"><t t-out="message"/></p><button class="plazy-primary-action" type="submit">Change password</button></form></section></main></t>
    </template>

    <template id="player_invitation_onboarding" name="Plazy Player Invitation">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="plazy-invitation-title"><section class="plazy-auth-panel plazy-otp-panel"><p class="plazy-eyebrow">TEAM INVITATION</p><h1 id="plazy-invitation-title">Welcome to Plazy!</h1><p class="plazy-auth-intro">You have been invited to join <strong><t t-out="invitation.team_id.name"/></strong><t t-if="invitation.position"> as <strong><t t-out="invitation.position"/></strong></t>.</p><p class="plazy-auth-intro">Plazy connects football players and teams so they can play together, organize matches, and grow their football community. Your team is planning to have you as part of their squad.</p><p class="plazy-auth-intro">Good luck, and welcome to the team!</p><form class="plazy-form" method="post" action="/plazy/player/invitation"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="token" t-att-value="token"/><button class="plazy-primary-action" name="action" value="continue" type="submit"><t t-if="existing_player and not signed_in_as_invitee">Log in &amp; accept invitation</t><t t-elif="existing_player">Accept invitation</t><t t-else="">Continue &amp; Set Password</t></button></form></section></main></t>
    </template>

    <template id="player_invitation_password" name="Set Invited Player Password">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="plazy-invitation-password-title"><section class="plazy-auth-panel plazy-otp-panel"><p class="plazy-eyebrow">JOINING <t t-out="invitation.team_id.name.upper()"/></p><h1 id="plazy-invitation-password-title">Set your password</h1><p class="plazy-auth-intro">Your details were added by your team manager.</p><form class="plazy-form" data-plazy-password-form="1" method="post" action="/plazy/player/invitation/set-password"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="token" t-att-value="token"/><label for="invited_player_email">Email</label><input id="invited_player_email" type="email" t-att-value="invitation.email" readonly="readonly"/><label for="invited_player_team">Team</label><input id="invited_player_team" type="text" t-att-value="invitation.team_id.name" readonly="readonly"/><label for="invited_player_name">Player name</label><input id="invited_player_name" type="text" t-att-value="invitation.player_name" readonly="readonly"/><label for="invited_player_password">New password</label><input id="invited_player_password" name="password" type="password" required="required" autocomplete="new-password" minlength="8"/><label for="invited_player_confirm_password">Confirm password</label><input id="invited_player_confirm_password" name="confirm_password" type="password" required="required" autocomplete="new-password" minlength="8"/><p class="plazy-form-error" t-if="error" role="alert"><t t-out="error"/></p><button class="plazy-primary-action" type="submit">Complete registration</button></form></section></main></t>
    </template>

    <template id="player_invitation_invalid" name="Invalid Plazy Player Invitation">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="plazy-invitation-invalid-title"><section class="plazy-auth-panel plazy-otp-panel plazy-success-panel"><p class="plazy-eyebrow">INVITATION UNAVAILABLE</p><h1 id="plazy-invitation-invalid-title">Invalid or Expired Invitation</h1><p class="plazy-auth-intro">This invitation may have expired, been cancelled, already been accepted, or the link is incomplete. Please ask your team manager to send a new invitation.</p><a class="plazy-primary-action plazy-primary-link" href="/web/login">Back to login</a></section></main></t>
    </template>

    <template id="password_reset_success" name="Plazy Password Reset Success">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="plazy-password-success-title"><section class="plazy-auth-panel plazy-otp-panel plazy-success-panel"><p class="plazy-eyebrow">PASSWORD UPDATED</p><h1 id="plazy-password-success-title">Your password has been changed successfully.</h1><p class="plazy-auth-intro">You can now log in with your new password.</p><a class="plazy-primary-action plazy-primary-link" href="/web/login">Back to Login</a></section></main></t>
    </template>

    <template id="player_join" name="Join Plazy as Player">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="player-join-title"><section class="plazy-auth-panel plazy-registration-panel"><h1 id="player-join-title">Join as Player</h1><p class="plazy-auth-intro">Create your player profile.</p><form class="plazy-form plazy-registration-form" method="post" action="/plazy/player/join"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="name">Name</label><input id="name" name="name" type="text" t-att-value="request.params.get('name', '')" required="required"/><label for="full_name">Full name</label><input id="full_name" name="full_name" type="text" t-att-value="request.params.get('full_name', '')" required="required"/><label for="email">Email address</label><input id="email" name="email" type="email" t-att-value="request.params.get('email', '')" required="required" autocomplete="email"/><p class="plazy-email-message" aria-live="polite"/><label for="mobile">Mobile number</label><input id="mobile" name="mobile" type="tel" t-att-value="request.params.get('mobile', '')" required="required" inputmode="numeric" pattern="[6-9][0-9]{9}"/><label for="age">Age</label><input id="age" name="age" type="number" t-att-value="request.params.get('age', '')" required="required" min="13" max="100"/><label for="locality">Locality in Bangalore</label><input id="locality" name="locality" type="text" t-att-value="request.params.get('locality', '')" required="required"/><label for="pincode">PIN code</label><input id="pincode" name="pincode" type="text" t-att-value="request.params.get('pincode', '')" required="required" inputmode="numeric" maxlength="6" pattern="[0-9]{6}"/><label for="player_password">Password</label><input id="player_password" name="password" type="password" required="required" autocomplete="new-password" minlength="8"/><label for="player_confirm_password">Confirm password</label><input id="player_confirm_password" name="confirm_password" type="password" required="required" autocomplete="new-password" minlength="8"/><p class="plazy-form-error" t-if="error" role="alert"><t t-out="error"/></p><div class="plazy-form-actions"><a class="plazy-secondary-action" href="/web/login">Back</a><button class="plazy-primary-action" type="submit">Send verification code</button></div></form></section></main></t>
    </template>

    <template id="team_join" name="Join Plazy as Team">
        <t t-call="web.login_layout"><main class="plazy-auth-page" aria-labelledby="team-join-title"><section class="plazy-auth-panel plazy-registration-panel"><h1 id="team-join-title">Register your team</h1><p class="plazy-auth-intro">Set up your squad, then invite up to 10 players.</p><form class="plazy-form plazy-registration-form" method="post" action="/plazy/team/join" enctype="multipart/form-data"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="name">Team name</label><input id="name" name="name" type="text" required="required"/><label for="manager_name">Manager name</label><input id="manager_name" name="manager_name" type="text" required="required"/><label for="email">Email address</label><input id="email" name="email" type="email" required="required" autocomplete="email"/><p class="plazy-email-message" aria-live="polite"/><label for="mobile">Mobile number</label><input id="mobile" name="mobile" type="tel" required="required" inputmode="numeric" pattern="[6-9][0-9]{9}"/><label for="team_type">Team type</label><select id="team_type" name="team_type" required="required"><option value="five_a_side">5-a-side (6 players required)</option><option value="seven_a_side">7-a-side (8 players required)</option></select><label for="logo">Team logo</label><input id="logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp"/><p class="plazy-auth-intro">AI logo generation can be added when an image-generation provider is configured; upload remains available at all times.</p><label for="locality">Locality in Bangalore</label><input id="locality" name="locality" type="text" required="required"/><label for="pincode">PIN code</label><input id="pincode" name="pincode" type="text" required="required" inputmode="numeric" maxlength="6" pattern="[0-9]{6}"/><label for="team_password">Password</label><input id="team_password" name="password" type="password" required="required" autocomplete="new-password" minlength="8"/><label for="team_confirm_password">Confirm password</label><input id="team_confirm_password" name="confirm_password" type="password" required="required" autocomplete="new-password" minlength="8"/><p class="plazy-form-error" t-if="error" role="alert"><t t-out="error"/></p><div class="plazy-form-actions"><a class="plazy-secondary-action" href="/web/login">Back</a><button class="plazy-primary-action" type="submit">Send verification code</button></div></form></section></main></t>
    </template>

    <template id="website_layout" name="Plazy Website Layout">
        <t t-set="title" t-value="title or 'Plazy Football'"/>
        <t t-call="web.frontend_layout" html_data="{'style': 'height: 100%;'}" body_classname.f="plazy-body" no_header="True" no_footer="True" head="head">
            <t t-set="company" t-value="request.env.company"/>
            <t t-set="instagram_url" t-value="company['social_instagram'] if 'social_instagram' in company._fields else ''"/>
            <t t-set="whatsapp_url" t-value="company['social_whatsapp'] if 'social_whatsapp' in company._fields else ''"/>
            <div class="plazy-site-shell"><t t-call="plazy.portal_header"/><t t-out="0"/><t t-call="plazy.portal_footer"/></div>
        </t>
    </template>

    <template id="portal_layout" name="Plazy Portal Layout">
        <t t-call="plazy.website_layout"><main class="plazy-portal-main"><t t-out="0"/></main></t>
    </template>

    <template id="portal_header" name="Plazy Portal Header">
        <header class="plazy-site-header">
            <a class="plazy-global-logo" href="/" aria-label="PLAZY Football home"><img class="plazy-brand-icon" src="/plazy/static/src/img/plazy-mark.svg" width="38" height="38" alt=""/><span class="plazy-global-name">PLAZY <small>FOOTBALL</small></span></a>
            <nav class="plazy-site-nav" aria-label="Main navigation"><a href="/">Home</a><a href="/#story">Our Story</a><a href="/#experience">The Experience</a><a href="/#community">Community</a></nav>
            <div class="plazy-header-actions" t-if="request.env.user._is_public()"><a class="plazy-header-signin" href="/web/login">Log in</a><a class="plazy-header-register" href="/plazy/join">Join now <i class="fa fa-arrow-right" aria-hidden="true"/></a></div>
            <details class="plazy-account-menu" t-else="">
                <summary><span class="plazy-account-avatar" aria-hidden="true"><i class="fa fa-user"/></span><span>Hi, <t t-out="(request.env.user.name or 'Player').split()[0]"/></span><i class="fa fa-chevron-down plazy-account-chevron" aria-hidden="true"/></summary>
                <div class="plazy-account-popover"><a href="/plazy/dashboard"><i class="fa fa-th-large" aria-hidden="true"/> My dashboard</a><form method="post" action="/web/session/logout"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="redirect" value="/"/><button type="submit"><i class="fa fa-sign-out" aria-hidden="true"/> Log out</button></form></div>
            </details>
            <details class="plazy-mobile-nav"><summary aria-label="Open navigation"><i class="fa fa-bars" aria-hidden="true"/></summary><nav aria-label="Mobile navigation"><a href="/">Home</a><a href="/#story">Our Story</a><a href="/#experience">The Experience</a><a href="/#community">Community</a><a href="/plazy/join">Join PLAZY</a></nav></details>
        </header>
    </template>

    <template id="portal_footer" name="Plazy Portal Footer">
        <footer class="plazy-portal-footer"><div class="plazy-footer-top"><p class="plazy-footer-kicker">PLAZY FOOTBALL</p><h2>The final whistle isn't the end of the story.</h2><p>Keep playing. Keep connecting. Keep the feeling alive.</p><a class="plazy-footer-cta" href="/plazy/join">Join the community <i class="fa fa-arrow-right" aria-hidden="true"/></a></div><div class="plazy-footer-links"><a href="/#story">Our Story</a><a href="/plazy/player/join">Players</a><a href="/plazy/team/join">Teams</a><a href="/#community">Community</a><a href="/web/login">Log in</a></div><div class="plazy-footer-bottom"><span class="plazy-footer-wordmark">PLAZY</span><p>MORE THAN A GAME. A PLACE TO BELONG.</p><div class="plazy-social-links" t-if="instagram_url or whatsapp_url"><a t-if="instagram_url" t-att-href="instagram_url" target="_blank" rel="noopener noreferrer" title="Instagram"><i class="fa fa-instagram" aria-hidden="true"/><span class="visually-hidden">Instagram</span></a><a t-if="whatsapp_url" t-att-href="whatsapp_url" target="_blank" rel="noopener noreferrer" title="WhatsApp"><i class="fa fa-whatsapp" aria-hidden="true"/><span class="visually-hidden">WhatsApp</span></a></div></div></footer>
    </template>

    <template id="player_dashboard" name="Plazy Player Dashboard"><t t-call="plazy.portal_layout"><section class="plazy-portal-dashboard"><div class="plazy-portal-intro"><p class="plazy-eyebrow">PLAYER PORTAL</p><h1>Hi, <t t-out="user_first_name"/>.</h1><p>Welcome to your football home.</p></div><section class="plazy-profile-card"><p class="plazy-profile-label">PLAYER PROFILE</p><h2><t t-out="player.full_name"/></h2><dl><div><dt>Locality</dt><dd><t t-out="player.locality"/></dd></div><div><dt>Mobile</dt><dd><t t-out="player.mobile"/></dd></div></dl></section></section></t></template>
    <template id="team_dashboard" name="Plazy Team Dashboard"><t t-call="plazy.portal_layout"><section class="plazy-portal-dashboard"><div class="plazy-portal-intro"><p class="plazy-eyebrow">TEAM PORTAL</p><h1><t t-out="team.name"/></h1><p t-if="team.registration_status == 'approved'">Your team has been approved by Plazy.</p><p t-else="">Manage your squad and complete team approval.</p></div><section class="plazy-profile-card"><p class="plazy-profile-label">TEAM PROGRESS</p><h2>Players Joined: <t t-out="team.joined_player_count"/> / <t t-out="team.required_player_count"/> required</h2><p class="plazy-auth-intro">Team type: <t t-out="dict(team._fields['team_type'].selection).get(team.team_type)"/> · Invitations: <t t-out="team.player_invitation_count"/> / 10</p><p class="plazy-form-error" t-if="team.registration_status == 'rejected'">Changes required: <t t-out="team.rejection_reason"/></p><p class="plazy-form-success" t-if="team.registration_status == 'waiting'">Waiting for Plazy Approval</p><form t-if="team.can_request_approval" method="post" action="/plazy/team/request-approval"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="plazy-primary-action" type="submit">Request Approval</button></form></section><section class="plazy-profile-card plazy-team-invitations" t-if="team.registration_status not in ('waiting', 'approved')"><p class="plazy-profile-label">INVITE A PLAYER</p><form class="plazy-form plazy-team-invite-form" method="post" action="/plazy/team/players/invite"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="team_player_name">Player name</label><input id="team_player_name" name="player_name" type="text" required="required"/><label for="team_player_email">Email address</label><input id="team_player_email" name="email" type="email" required="required" autocomplete="email"/><p class="plazy-email-message" aria-live="polite"/><label for="team_player_mobile">Mobile number</label><input id="team_player_mobile" name="mobile" type="tel" required="required" inputmode="numeric"/><label for="team_player_position">Position</label><input id="team_player_position" name="position" type="text"/><button class="plazy-primary-action" type="submit">Send invitation</button></form></section><p class="plazy-form-error" t-if="invitation_error" role="alert"><t t-out="invitation_error"/></p><p class="plazy-form-success" t-if="invitation_message" role="status"><t t-out="invitation_message"/></p><section class="plazy-profile-card plazy-team-invitations"><p class="plazy-profile-label">PLAYER INVITATIONS</p><p t-if="not invitations" class="plazy-auth-intro">No players have been invited yet.</p><div class="plazy-invitation-list" t-if="invitations"><div class="plazy-invitation-row" t-foreach="invitations" t-as="invitation"><div><strong><t t-out="invitation.player_name"/></strong><small><t t-out="invitation.email"/><t t-if="invitation.position"> · <t t-out="invitation.position"/></t></small></div><div class="plazy-invitation-actions"><span t-attf-class="plazy-invitation-status is-#{invitation.status}"><t t-out="dict(invitation._fields['status'].selection).get(invitation.status)"/></span><form t-if="invitation.status in ('sent', 'expired', 'failed')" method="post" t-att-action="'/plazy/team/players/invitation/%s/resend' % invitation.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="plazy-inline-action">Resend</button></form><form t-if="invitation.status == 'sent'" method="post" t-att-action="'/plazy/team/players/invitation/%s/cancel' % invitation.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="plazy-inline-action">Cancel</button></form></div></div></div></section></section></t></template>
    <template id="admin_dashboard" name="Plazy Admin Dashboard"><t t-call="plazy.portal_layout"><section class="plazy-portal-dashboard plazy-admin-dashboard"><div class="plazy-portal-intro"><p class="plazy-eyebrow">PLAZY ADMIN</p><h1>Hi, <t t-out="user_first_name"/>.</h1><p>Manage the local football community from one place.</p></div><a class="plazy-admin-menu-back" href="/plazy/admin/choose">Back to Admin Menu</a><div class="plazy-admin-grid"><a class="plazy-admin-card" href="/odoo/action-plazy.action_plazy_team"><span>Teams</span><strong><t t-out="team_count"/></strong><small>Manage team profiles</small></a><a class="plazy-admin-card" href="/odoo/action-plazy.action_plazy_player"><span>Players</span><strong><t t-out="player_count"/></strong><small>Manage player profiles</small></a><a class="plazy-admin-card" href="/odoo/action-base.action_res_users"><span>Registered users</span><strong><t t-out="registered_user_count"/></strong><small>Manage user accounts</small></a></div></section></t></template>
    <template id="admin_team_approvals" inherit_id="plazy.admin_dashboard" name="Plazy Pending Team Approvals"><xpath expr="//div[hasclass('plazy-admin-grid')]" position="after"><section class="plazy-profile-card plazy-team-invitations"><p class="plazy-profile-label">PENDING TEAM APPROVAL REQUESTS</p><p t-if="not pending_approval_teams" class="plazy-auth-intro">There are no pending approval requests.</p><div class="plazy-invitation-list" t-if="pending_approval_teams"><div class="plazy-invitation-row" t-foreach="pending_approval_teams" t-as="approval_team"><div><strong><t t-out="approval_team.name"/></strong><small><t t-out="dict(approval_team._fields['team_type'].selection).get(approval_team.team_type)"/> · <t t-out="approval_team.joined_player_count"/> / <t t-out="approval_team.required_player_count"/> joined · <t t-out="approval_team.email"/></small></div><div class="plazy-invitation-actions"><form method="post" t-att-action="'/plazy/admin/team/%s/approve' % approval_team.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="plazy-inline-action">Approve</button></form><form method="post" t-att-action="'/plazy/admin/team/%s/reject' % approval_team.id"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input name="reason" type="text" required="required" placeholder="Rejection reason"/><button type="submit" class="plazy-inline-action">Reject</button></form></div></div></div></section></xpath></template>
    <template id="admin_destination" name="Plazy Admin Destination"><t t-call="plazy.portal_layout"><section id="plazy-admin-choice-fallback" class="plazy-admin-choice" aria-labelledby="plazy-admin-choice-title"><p class="plazy-eyebrow">ADMIN ACCESS</p><h1 id="plazy-admin-choice-title">Choose your workspace</h1><p>Select where you want to continue.</p><div class="plazy-admin-choice-grid"><a class="plazy-admin-choice-option" href="/odoo"><span class="plazy-admin-choice-mark">B</span><span><strong>Backend</strong><small>Open the administration workspace</small></span></a><a class="plazy-admin-choice-option" href="/plazy/admin/dashboard"><span class="plazy-admin-choice-mark">P</span><span><strong>Plazy Admin</strong><small>Open the Plazy management dashboard</small></span></a></div></section><div id="plazy-admin-destination"/></t></template>
    <template id="home" name="Plazy Home">
        <t t-call="plazy.website_layout">
            <t t-set="title">PLAZY Football | More Than A Game. A Place To Belong.</t>
            <main class="plazy-home">
                <section class="plazy-home-hero" aria-labelledby="plazy-home-title">
                    <div class="plazy-home-wrap plazy-home-hero-content" data-plazy-reveal="hero">
                        <p class="plazy-home-kicker">BENGALURU FOOTBALL COMMUNITY</p>
                        <h1 id="plazy-home-title">You grew up.<br/><em>Your love for football didn't.</em></h1>
                        <p>Life took us to different cities, careers, and paths. But somewhere inside us, the footballer is still waiting for the next game.</p>
                        <div class="plazy-home-actions"><a class="plazy-home-button" t-att-href="'/plazy/join' if request.env.user._is_public() else '/plazy/dashboard'">Find your game <i class="fa fa-arrow-right" aria-hidden="true"/></a><a class="plazy-home-link" href="#story">Our story <i class="fa fa-arrow-down" aria-hidden="true"/></a></div>
                    </div>
                    <p class="plazy-home-hero-note">Built for everyone who never stopped loving football.</p>
                    <a class="plazy-home-scroll" href="#story" aria-label="Read our story"><span/></a>
                </section>

                <section id="story" class="plazy-home-story" aria-labelledby="plazy-story-title">
                    <div class="plazy-home-wrap plazy-home-story-grid">
                        <div class="plazy-home-story-copy" data-plazy-reveal="up"><p class="plazy-home-kicker">THE STORY BEHIND PLAZY</p><h2 id="plazy-story-title">Some dreams never leave the pitch.</h2><p>We grew up chasing footballs through streets, school grounds, and open fields. We did not need perfect stadiums or expensive boots. We just needed a ball, a few friends, and somewhere to play.</p><p>Then life happened. We moved away. We started working. Our old teams scattered. But the love for football stayed.</p><p>PLAZY was born from a simple belief: growing up should never mean giving up the game you love.</p><strong>The dream may change. The feeling never does.</strong></div>
                        <figure class="plazy-home-story-image" data-plazy-reveal="image"><img src="/plazy/static/src/img/plazy-story-kerala.png" alt="Friends enjoying football together on a Kerala ground at sunset" loading="lazy"/><figcaption>Kerala roots. Bengaluru next. One shared love for the game.</figcaption></figure>
                    </div>
                </section>

                <section class="plazy-home-lives" aria-labelledby="plazy-lives-title"><div class="plazy-home-wrap"><p class="plazy-home-kicker">DIFFERENT LIVES. ONE GAME.</p><h2 id="plazy-lives-title">Monday to Friday, we have different lives.<br/><em>On the pitch, we are teammates.</em></h2><p class="plazy-home-intro">Whatever you do. Wherever you are from. There is a place for you on the pitch.</p><div class="plazy-home-life-grid"><article><span>01</span><i class="fa fa-laptop" aria-hidden="true"/><h3>Builders</h3><p>When the laptop closes, the boots come out.</p></article><article><span>02</span><i class="fa fa-heartbeat" aria-hidden="true"/><h3>Caregivers</h3><p>A game can be the breath after a long shift.</p></article><article><span>03</span><i class="fa fa-book" aria-hidden="true"/><h3>Students</h3><p>Between classes, football makes a new city feel familiar.</p></article><article><span>04</span><i class="fa fa-lightbulb-o" aria-hidden="true"/><h3>Creators</h3><p>Different expressions. One instinct to play.</p></article></div></div></section>

                <section id="experience" class="plazy-home-experience" aria-labelledby="plazy-experience-title"><div class="plazy-home-wrap plazy-home-experience-grid"><div data-plazy-reveal="up"><p class="plazy-home-kicker">THE PLAZY EXPERIENCE</p><h2 id="plazy-experience-title">New city? No team? No problem.</h2><p>Moving somewhere new should not mean leaving football behind. Begin with your player or team profile, then build the connections that bring a match to life.</p><a class="plazy-home-button" t-att-href="'/plazy/join' if request.env.user._is_public() else '/plazy/dashboard'">Explore PLAZY <i class="fa fa-arrow-right" aria-hidden="true"/></a></div><ol class="plazy-home-path"><li><span>01</span><div><h3>Create your place</h3><p>Join as a player or register your team.</p></div></li><li><span>02</span><div><h3>Build your squad</h3><p>Team managers can invite players through PLAZY.</p></div></li><li><span>03</span><div><h3>Step onto the pitch</h3><p>More community discovery is on its way.</p></div></li></ol></div></section>

                <section class="plazy-home-emotion" aria-labelledby="plazy-emotion-title"><div class="plazy-home-wrap" data-plazy-reveal="up"><p class="plazy-home-kicker">FOOTBALL IS AN EMOTION</p><h2 id="plazy-emotion-title">For some, it's just a game.<br/><em>For us, it's a feeling that never left.</em></h2><p>It's the sound of the ball hitting the net. The friend who always passes to you. The final goal before sunset. The joy of winning and the silence after losing.</p><strong>You do not stop being a footballer when the match ends.</strong></div></section>

                <section class="plazy-home-stories" aria-labelledby="plazy-player-stories-title"><div class="plazy-home-wrap"><div class="plazy-home-section-heading"><p class="plazy-home-kicker">EVERY PLAYER HAS A STORY</p><h2 id="plazy-player-stories-title">Every reason to play belongs here.</h2><p>Illustrative stories of the people PLAZY is being built for. Real community stories will come from the people who make them.</p></div><div class="plazy-home-story-cards"><article data-plazy-reveal="up"><span>RETURNING</span><h3>The player coming back after years away</h3><p>Some boots wait patiently. The first game back can start with one small yes.</p></article><article data-plazy-reveal="up"><span>ARRIVING</span><h3>The newcomer looking for a team</h3><p>A new city feels less new when someone calls you teammate.</p></article><article data-plazy-reveal="up"><span>BEGINNING</span><h3>The beginner playing for the feeling</h3><p>You do not need to be a professional to belong on the pitch.</p></article></div></div></section>

                <section class="plazy-home-generation" aria-labelledby="plazy-generation-title"><div class="plazy-home-wrap plazy-home-generation-grid"><div><p class="plazy-home-kicker">THE NEXT GENERATION</p><h2 id="plazy-generation-title">The next generation deserves more places to play.</h2></div><div><p>Every football journey starts somewhere: a school ground, a neighborhood pitch, a first pair of boots, a friend who says, "Come, let's play."</p><p>We want more young people in India to experience that beginning, and to find communities that help them continue.</p></div></div></section>

                <section id="community" class="plazy-home-community" aria-labelledby="plazy-community-title"><div class="plazy-home-wrap"><p class="plazy-home-kicker">THE COMMUNITY MOVEMENT</p><h2 id="plazy-community-title">Football belongs to everyone.</h2><p>From Kerala's football-loving neighborhoods to Bengaluru's after-work games, football connects people who might never have met otherwise. PLAZY wants to make those connections easier: one player, one team, one match at a time.</p><div class="plazy-home-coming-soon"><i class="fa fa-compass" aria-hidden="true"/><div><h3>Community discovery is coming soon.</h3><p>Today, you can create a player profile, register a team, and invite players. Game discovery and local communities are planned next.</p></div></div></div></section>

                <section class="plazy-home-final" aria-labelledby="plazy-final-title"><div class="plazy-home-wrap"><p class="plazy-home-kicker">YOUR NEXT GAME STARTS HERE</p><h2 id="plazy-final-title">The game is still waiting for you.</h2><p>Maybe it has been years. Maybe you are new to the city. Maybe you have never played before. It does not matter. There is always room for one more player.</p><div class="plazy-home-actions"><a class="plazy-home-button" t-att-href="'/plazy/join' if request.env.user._is_public() else '/plazy/dashboard'"><t t-if="request.env.user._is_public()">Let's play football</t><t t-else="">Go to my dashboard</t><i class="fa fa-arrow-right" aria-hidden="true"/></a><a class="plazy-home-link" href="/plazy/team/join">Register a team</a></div><p class="plazy-home-brandline">PLAZY FOOTBALL - MORE THAN A GAME. A PLACE TO BELONG.</p></div></section>
            </main>
        </t>
    </template>
</odoo>
