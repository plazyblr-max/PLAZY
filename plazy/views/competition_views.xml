<odoo>
    <record id="view_tournament_list" model="ir.ui.view"><field name="name">plazy.tournament.list</field><field name="model">plazy.tournament</field><field name="arch" type="xml"><list><field name="name"/><field name="football_format"/><field name="format"/><field name="location"/><field name="start_date"/><field name="approved_count"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_tournament_form" model="ir.ui.view"><field name="name">plazy.tournament.form</field><field name="model">plazy.tournament</field><field name="arch" type="xml">
        <form><header>
            <button name="action_open" type="object" string="Open Registration" invisible="state != 'draft'" class="btn-primary"/>
            <button name="action_close" type="object" string="Close Registration" invisible="state != 'open'"/>
            <button name="action_generate_league" type="object" string="Generate League" invisible="state != 'closed' or format == 'knockout'"/>
            <button name="action_generate_knockout" type="object" string="Generate Knockout" invisible="format == 'league' or state not in ('closed', 'scheduled', 'live')"/>
            <button name="action_publish" type="object" string="Publish Fixtures" invisible="state not in ('closed', 'scheduled', 'live')"/>
            <button name="action_schedule" type="object" string="Auto Schedule" invisible="state not in ('closed', 'scheduled', 'live')"/>
            <button name="action_complete" type="object" string="Complete Competition" invisible="state != 'live'"/>
            <button name="action_postpone" type="object" string="Postpone" invisible="state in ('completed', 'cancelled', 'postponed')"/>
            <button name="action_resume" type="object" string="Resume" invisible="state != 'postponed'"/>
            <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed', 'cancelled')"/>
            <field name="state" widget="statusbar"/>
        </header><sheet><group><field name="name"/><field name="logo" widget="image"/><field name="company_id"/><field name="football_format"/><field name="format"/><field name="location"/><field name="published"/><field name="champion_id"/></group>
        <notebook><page string="Configuration"><group><group><field name="registration_start"/><field name="registration_end"/><field name="start_date"/><field name="end_date"/><field name="min_teams"/><field name="max_teams"/></group><group><field name="group_count"/><field name="qualifiers"/><field name="double_round"/><field name="duration"/><field name="rest_minutes"/><field name="win_points"/><field name="draw_points"/><field name="loss_points"/><field name="tie_breaker"/></group></group><field name="description"/><field name="rules"/><field name="change_reason"/></page>
        <page string="Scheduling"><group><field name="venue_ids" widget="many2many_tags"/><field name="max_matches_day"/></group></page><page string="Applications"><field name="registration_ids"/></page><page string="Groups"><field name="group_ids" readonly="1"/></page><page string="Fixtures"><field name="match_ids"/></page></notebook></sheet></form>
    </field></record>
    <record id="view_competition_registration_list" model="ir.ui.view"><field name="name">plazy.tournament.registration.list</field><field name="model">plazy.tournament.registration</field><field name="arch" type="xml"><list><field name="tournament_id"/><field name="team_id"/><field name="group_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_competition_registration_form" model="ir.ui.view"><field name="name">plazy.tournament.registration.form</field><field name="model">plazy.tournament.registration</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve / Waitlist" class="btn-primary" invisible="state not in ('pending', 'waitlisted')"/><button name="action_reject" type="object" string="Reject"/><field name="state" widget="statusbar"/></header><sheet><group><field name="tournament_id"/><field name="team_id"/><field name="group_id" readonly="1"/><field name="reason"/><field name="roster_ids" widget="many2many_tags" readonly="1"/></group></sheet></form></field></record>
    <record id="view_competition_match_list" model="ir.ui.view"><field name="name">plazy.tournament.match.list</field><field name="model">plazy.tournament.match</field><field name="arch" type="xml"><list><field name="tournament_id"/><field name="fixture_key"/><field name="round_number"/><field name="home_id"/><field name="home_score"/><field name="away_score"/><field name="away_id"/><field name="kickoff"/><field name="venue_id"/><field name="state"/><field name="published"/></list></field></record>
    <record id="view_competition_match_form" model="ir.ui.view"><field name="name">plazy.tournament.match.form</field><field name="model">plazy.tournament.match</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirm Result" class="btn-primary" invisible="state in ('completed', 'walkover')"/><button name="action_reopen" type="object" string="Reopen for Correction" invisible="state not in ('completed', 'walkover')"/><button name="action_live" type="object" string="Kickoff" invisible="state != 'scheduled'"/><button name="action_postpone" type="object" string="Postpone" invisible="state not in ('scheduled', 'live')"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed', 'walkover')"/><button name="action_abandon" type="object" string="Abandon" invisible="state != 'live'"/><button name="action_reschedule" type="object" string="Reschedule" invisible="state not in ('postponed', 'cancelled', 'abandoned')"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="tournament_id"/><field name="fixture_key"/><field name="stage"/><field name="group_id"/><field name="round_number"/><field name="home_id"/><field name="away_id"/></group><group><field name="kickoff"/><field name="venue_id"/><field name="duration"/><field name="referee"/><field name="published"/></group></group><group string="Result"><field name="result_kind"/><field name="result_entered"/><field name="home_score"/><field name="away_score"/><field name="extra_home"/><field name="extra_away"/><field name="penalties_home"/><field name="penalties_away"/><field name="winner_id"/><field name="completed_at"/></group><field name="notes"/><field name="correction_reason"/><group string="Progression"><field name="next_match_id" readonly="1"/><field name="next_slot" readonly="1"/></group><field name="audit_ids" readonly="1"><list><field name="create_date"/><field name="create_uid"/><field name="description"/></list></field></sheet></form></field></record>
    <record id="view_competition_calendar" model="ir.ui.view"><field name="name">plazy.tournament.match.calendar</field><field name="model">plazy.tournament.match</field><field name="arch" type="xml"><calendar date_start="kickoff" color="tournament_id" string="Match Calendar"><field name="home_id"/><field name="away_id"/><field name="venue_id"/></calendar></field></record>
    <record id="view_competition_venue_form" model="ir.ui.view"><field name="name">plazy.tournament.venue.form</field><field name="model">plazy.tournament.venue</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="location"/></group><field name="slot_ids"><list editable="bottom"><field name="start"/><field name="end"/></list></field></sheet></form></field></record>
    <record id="view_plazy_company_roster" model="ir.ui.view"><field name="name">res.company.plazy.roster</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="PLAZY Roster Policy" groups="base.group_system,plazy.competition_admin"><field name="plazy_five_min"/><field name="plazy_five_max"/></group></xpath></field></record>
    <record id="action_tournaments" model="ir.actions.act_window"><field name="name">Tournaments</field><field name="res_model">plazy.tournament</field><field name="view_mode">list,form</field></record>
    <record id="action_competition_registrations" model="ir.actions.act_window"><field name="name">Tournament Applications</field><field name="res_model">plazy.tournament.registration</field><field name="view_mode">list,form</field></record>
    <record id="action_competition_matches" model="ir.actions.act_window"><field name="name">Match Centre</field><field name="res_model">plazy.tournament.match</field><field name="view_mode">list,calendar,form</field></record>
    <record id="action_competition_venues" model="ir.actions.act_window"><field name="name">Grounds and Availability</field><field name="res_model">plazy.tournament.venue</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_tournaments" name="Tournaments" parent="menu_plazy_root" action="action_tournaments" groups="base.group_system,plazy.competition_admin" sequence="30"/>
    <menuitem id="menu_competition_registrations" name="Tournament Applications" parent="menu_plazy_root" action="action_competition_registrations" groups="base.group_system,plazy.competition_admin" sequence="31"/>
    <menuitem id="menu_competition_matches" name="Matches" parent="menu_plazy_root" action="action_competition_matches" groups="base.group_system,plazy.competition_admin" sequence="32"/>
    <menuitem id="menu_competition_venues" name="Grounds" parent="menu_plazy_root" action="action_competition_venues" groups="base.group_system,plazy.competition_admin" sequence="33"/>
</odoo>
