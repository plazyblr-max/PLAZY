<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">


        <record id="mail_template_registration_otp" model="mail.template">
            <field name="name">Plazy: Registration Email Verification</field>
            <field name="model_id" ref="model_plazy_registration_otp"/>
            <field name="subject">Your Plazy verification code</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html"><t>
                <div style="background:#f4f8f5; padding:28px; font-family:Arial, sans-serif; color:#183322;">
                    <div style="max-width:540px; margin:0 auto; background:#ffffff; border:1px solid #dcebdd; border-radius:12px; padding:28px;">
                        <p style="color:#2a9456; font-weight:700; letter-spacing:1px; margin:0 0 16px;">PLAZY FOOTBALL</p>
                        <h2 style="margin:0 0 12px; color:#183322;">Verify your email</h2>
                        <p style="line-height:1.5;">Use this code to complete your Plazy registration:</p>
                        <p style="background:#eaf7ed; border:1px solid #b7dfbe; border-radius:8px; color:#176638; font-size:28px; font-weight:700; letter-spacing:7px; margin:20px 0; padding:16px; text-align:center;"><t t-out="object.otp_code"/></p>
                        <p style="line-height:1.5;">This code expires in 10 minutes. If you did not request this registration, you can safely ignore this email.</p>
                    </div>
                </div>
            </t></field>
        </record>

        <record id="mail_template_password_reset_otp" model="mail.template">
            <field name="name">Plazy: Password Reset Verification</field>
            <field name="model_id" ref="model_plazy_registration_otp"/>
            <field name="subject">Your Plazy password reset code</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html"><t>
                <div style="background:#f4f8f5; padding:28px; font-family:Arial, sans-serif; color:#183322;">
                    <div style="max-width:540px; margin:0 auto; background:#ffffff; border:1px solid #dcebdd; border-radius:12px; padding:28px;">
                        <p style="color:#2a9456; font-weight:700; letter-spacing:1px; margin:0 0 16px;">PLAZY FOOTBALL</p>
                        <h2 style="margin:0 0 12px; color:#183322;">Reset your password</h2>
                        <p style="line-height:1.5;">Use this code to verify your password reset request:</p>
                        <p style="background:#eaf7ed; border:1px solid #b7dfbe; border-radius:8px; color:#176638; font-size:28px; font-weight:700; letter-spacing:7px; margin:20px 0; padding:16px; text-align:center;"><t t-out="object.otp_code"/></p>
                        <p style="line-height:1.5;">This code expires in 10 minutes. If you did not request a password reset, you can safely ignore this email.</p>
                    </div>
                </div>
            </t></field>
        </record>
        <record id="mail_template_team_player_invitation" model="mail.template">
            <field name="name">Plazy: Team Player Invitation</field>
            <field name="model_id" ref="model_plazy_team_player_invitation"/>
            <field name="subject">You have been invited to join {{ object.team_id.name }} on Plazy</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html"><t>
                <div style="background:#f4f8f5; padding:28px; font-family:Arial, sans-serif; color:#183322;">
                    <div style="max-width:540px; margin:0 auto; background:#ffffff; border:1px solid #dcebdd; border-radius:12px; padding:28px;">
                        <p style="color:#2a9456; font-weight:700; letter-spacing:1px; margin:0 0 16px;">PLAZY FOOTBALL</p>
                        <h2 style="margin:0 0 12px; color:#183322;">You have been invited to join <t t-out="object.team_id.name"/></h2>
                        <p style="line-height:1.5;">Hello <t t-out="object.player_name"/>,</p>
                        <p style="line-height:1.5;"><t t-out="object.team_id.name"/> would like you to join their Plazy squad<t t-if="object.position"> as <strong><t t-out="object.position"/></strong></t>.</p>
                        <p style="line-height:1.5;">Plazy connects football players and teams so they can play together, organize matches, and grow their football community.</p>
                        <p style="line-height:1.5;">Accept this invitation to set up your account, or sign in to your existing Plazy account and join the team.</p>
                        <p style="margin:24px 0; text-align:center;"><a t-att-href="object.get_invitation_url()" style="background:#32a85f; border-radius:8px; color:#ffffff; display:inline-block; font-weight:700; padding:14px 22px; text-decoration:none;">Accept Invitation &amp; Register</a></p>
                        <p style="color:#557060; font-size:12px; line-height:1.5;">This secure invitation expires in seven days. If you were not expecting it, you can safely ignore this email.</p>
                    </div>
                </div>
            </t></field>
        </record>
        <record id="mail_template_team_approval_requested" model="mail.template">
            <field name="name">Plazy: Team Approval Request Received</field>
            <field name="model_id" ref="model_plazy_team"/>
            <field name="subject">Your Team Approval Request Has Been Received</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html"><t><div style="background:#f4f8f5;padding:28px;font-family:Arial,sans-serif;color:#183322"><div style="max-width:540px;margin:auto;background:#fff;border:1px solid #dcebdd;border-radius:12px;padding:28px"><p style="color:#2a9456;font-weight:700;letter-spacing:1px">PLAZY FOOTBALL</p><h2>Approval request received</h2><p>Hi <t t-out="object.manager_name or object.name"/>,</p><p>We have received the approval request for <strong><t t-out="object.name"/></strong>.</p><p>Our team will review your team details and player list. Current status: <strong>Waiting for Approval</strong>.</p><p>Plazy</p></div></div></t></field>
        </record>
        <record id="mail_template_team_approved" model="mail.template">
            <field name="name">Plazy: Team Approved</field>
            <field name="model_id" ref="model_plazy_team"/>
            <field name="subject">{{ object.name }} Is Approved!</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html"><t><div style="background:#f4f8f5;padding:28px;font-family:Arial,sans-serif;color:#183322"><div style="max-width:540px;margin:auto;background:#fff;border:1px solid #dcebdd;border-radius:12px;padding:28px"><p style="color:#2a9456;font-weight:700;letter-spacing:1px">PLAZY FOOTBALL</p><h2>Great news!</h2><p>Hi <t t-out="object.manager_name or object.name"/>,</p><p><strong><t t-out="object.name"/></strong> has been approved by Plazy and is now officially active on the platform.</p><p>Play together. Grow together.</p><p>Plazy</p></div></div></t></field>
        </record>
        <record id="mail_template_team_rejected" model="mail.template">
            <field name="name">Plazy: Team Changes Required</field>
            <field name="model_id" ref="model_plazy_team"/>
            <field name="subject">Update Required for {{ object.name }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html"><t><div style="background:#f4f8f5;padding:28px;font-family:Arial,sans-serif;color:#183322"><div style="max-width:540px;margin:auto;background:#fff;border:1px solid #dcebdd;border-radius:12px;padding:28px"><p style="color:#2a9456;font-weight:700;letter-spacing:1px">PLAZY FOOTBALL</p><h2>Update required</h2><p>Hi <t t-out="object.manager_name or object.name"/>,</p><p>We reviewed <strong><t t-out="object.name"/></strong>, and some changes are needed before approval.</p><p style="background:#fff4f4;border-left:3px solid #c95b5b;padding:12px"><strong>Reason:</strong> <t t-out="object.rejection_reason"/></p><p>Please update the required information and submit again.</p><p>Plazy</p></div></div></t></field>
        </record>
    </data>
</odoo>
