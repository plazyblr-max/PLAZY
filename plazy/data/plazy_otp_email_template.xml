<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_registration_otp" model="mail.template">
            <field name="name">Plazy: Registration Email Verification</field>
            <field name="model_id" ref="model_plazy_registration_otp"/>
            <field name="subject">Your Plazy verification code</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html"><t>
                <div style="background:#f4f8f5; padding:28px; font-family:Arial, sans-serif; color:#183322;">
                    <div style="max-width:540px; margin:0 auto; background:#ffffff; border:1px solid #dcebdd; border-radius:12px; padding:28px;">
                        <p style="color:#2a9456; font-weight:700; letter-spacing:1px; margin:0 0 16px;">PLAZY FOOTBALL</p>
                        <h2 style="margin:0 0 12px; color:#183322;">Verify your email</h2>
                        <p style="line-height:1.5;">Use this code to complete your Plazy registration:</p>
                        <p style="background:#eaf7ed; border:1px solid #b7dfbe; border-radius:8px; color:#176638; font-size:28px; font-weight:700; letter-spacing:7px; margin:20px 0; padding:16px; text-align:center;"><t t-out="object.otp_code"/></p>
                        <p style="line-height:1.5;">This code expires in 10 minutes. If you did not request this registration, you can safely ignore this email.</p>
                    </div>
                </div>
            </t></field>
        </record>
        <record id="mail_template_password_reset_otp" model="mail.template">
            <field name="name">Plazy: Password Reset Verification</field>
            <field name="model_id" ref="model_plazy_registration_otp"/>
            <field name="subject">Your Plazy password reset code</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html"><t>
                <div style="background:#f4f8f5; padding:28px; font-family:Arial, sans-serif; color:#183322;">
                    <div style="max-width:540px; margin:0 auto; background:#ffffff; border:1px solid #dcebdd; border-radius:12px; padding:28px;">
                        <p style="color:#2a9456; font-weight:700; letter-spacing:1px; margin:0 0 16px;">PLAZY FOOTBALL</p>
                        <h2 style="margin:0 0 12px; color:#183322;">Reset your password</h2>
                        <p style="line-height:1.5;">Use this code to verify your password reset request:</p>
                        <p style="background:#eaf7ed; border:1px solid #b7dfbe; border-radius:8px; color:#176638; font-size:28px; font-weight:700; letter-spacing:7px; margin:20px 0; padding:16px; text-align:center;"><t t-out="object.otp_code"/></p>
                        <p style="line-height:1.5;">This code expires in 10 minutes. If you did not request a password reset, you can safely ignore this email.</p>
                    </div>
                </div>
            </t></field>
        </record>
    </data>
</odoo>
